# /etc/conf.d/hopiumd: config file for /etc/init.d/hopiumd

# Config file location
#BLACKMORED_CONFIGFILE="/etc/hopium/hopium.conf"

# What directory to write pidfile to?  (created and owned by $BLACKMORED_USER)
#BLACKMORED_PIDDIR="/var/run/hopiumd"

# What filename to give the pidfile
#BLACKMORED_PIDFILE="${BLACKMORED_PIDDIR}/hopiumd.pid"

# Where to write hopiumd data (be mindful that the blockchain is large)
#BLACKMORED_DATADIR="/var/lib/hopiumd"

# User and group to own hopiumd process
#BLACKMORED_USER="hopium"
#BLACKMORED_GROUP="hopium"

# Path to hopiumd executable
#BLACKMORED_BIN="/usr/bin/hopiumd"

# Nice value to run hopiumd under
#BLACKMORED_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#BLACKMORED_OPTS=""

# The timeout in seconds OpenRC will wait for hopiumd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
BLACKMORED_SIGTERM_TIMEOUT=600
